  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialHints
  panel: {fileID: 1512017713}
  label: {fileID: 600821828}
  nextButton: {fileID: 1176100245}
  nextLabel: {fileID: 1535795660}
  skipTutorialButton: {fileID: 742040189}
  pointer: {fileID: 242165997}
  pointerOffset: {x: 0.45, y: 0.75}
  steps:
  - text: Drag the hedgehog back, aim with the dotted line, and let go!
    pointAt: 1
  - text: Pop every hen to clear the garden. Hogs you don't need are worth bonus
      points!
    pointAt: 2
  - text: This red one goes BOOM a moment after it lands. Drop it right next to a
      hen!
    pointAt: 1
  - text: A cluster hog! Launch it, then tap anywhere while it's flying to split
      it into five.
    pointAt: 1
  - text: TAP NOW to split it!
    pointAt: 3
  - text: The minis rain down and to the right. Now finish off the hens!
    pointAt: 2
